  },
  "dependencies": {
    "@types/cytoscape": "^3.21.9",
    "concurrently": "^8.2.2",
    "cytoscape": "^3.31.1",
    "cytoscape-dagre": "^2.5.0",
    "framer-motion": "^12.9.4",
    "lucide-react": "^0.506.0",
    "react-cytoscapejs": "^2.0.0",
    "reactflow": "^11.11.4"
  }
}
