{
  "name": "iwannagraduate",
  "version": "1.0.0",
  "description": "GMU Course Planning Tool",
  "main": "index.js",
  "scripts": {
    "start:backend-python": "cd . && uvicorn api.main:app --reload",
    "start:backend-maven": "cd Backend/patriotassist_gmu && mvn spring-boot:run",
